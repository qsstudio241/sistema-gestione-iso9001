# Copia questo file in mcp.env (stessa cartella) e compila i valori SENZA virgolette.
# mcp.env è gitignored — non committare segreti.
#
# ?? GitHub MCP (server HTTP) ??
# envFile NON funziona per server url-based (solo stdio). Dopo il PAT:
#   1. powershell -ExecutionPolicy Bypass -File .cursor/sync-github-mcp-env.ps1
#   2. Riavvia Cursor completamente.
# Token: github_pat_ (fine-grained) o ghp_ (classic). Mai "Bearer " nel valore.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_sostituisci_con_il_tuo_token
#
# ?? Smoke login app (Playwright / E2E) ??
# Account test superadmin org Al.project (produzione Netlify + API VPS).
# NON incollare la password in chat o in file versionati.
#
# Desktop (Cursor locale):
#   1. Compila SGQ_APP_* sotto, salva mcp.env
#   2. powershell -ExecutionPolicy Bypass -File .cursor/sync-sgq-smoke-env.ps1
#   3. Riavvia Cursor
#
# Cursor Cloud Agent:
#   Settings ? Cloud ? Secrets ? SGQ_APP_EMAIL / SGQ_APP_PASSWORD
#   (stessi nomi; il cloud agent NON legge mcp.env locale)
#
# Password ambiente test: vault / referente (non in repository).
SGQ_APP_EMAIL=admin@sgq.local
SGQ_APP_PASSWORD=INCOLLA_PASSWORD_TEST_QUI
